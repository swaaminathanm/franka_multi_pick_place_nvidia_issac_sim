#usda 1.0
(
    defaultPrim = "bin"
    metersPerUnit = 1.0
    upAxis = "Z"
)

# Hollow bin: one kinematic rigid body, five box meshes.
# Outer 0.20 x 0.20 m, floor 0.01 m, walls 0.02 m thick and 0.08 m tall.
# Inner cavity is 0.16 x 0.16 x 0.08 m.
#
# Each box is a Mesh with its corners already in metres. A USD Cube cannot
# store a different length on each axis, so the usual trick is a unit cube
# plus xformOp:scale. Newton/Viser drops that scale on the way to the viewer,
# and each wall collapses into the pyramid in the screenshot. These points
# do not need a scale.

def Xform "bin" (
    kind = "component"
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    bool physics:kinematicEnabled = true
    float physics:mass = 0.5

    def Scope "Looks"
    {
        def Material "BlueMaterial"
        {
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.10, 0.45, 0.85)
                float inputs:roughness = 0.4
                float inputs:metallic = 0.0
                token outputs:surface
            }
            token outputs:surface.connect = </bin/Looks/BlueMaterial/Shader.outputs:surface>
        }
    }

    # Floor: z = 0 to 0.01, covering the full 0.20 x 0.20 footprint.
    def Mesh "floor" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
    )
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 2, 3, 7, 6, 0, 4, 7, 3, 1, 2, 6, 5]
        point3f[] points = [(-0.10, -0.10, 0.00), (0.10, -0.10, 0.00), (0.10, 0.10, 0.00), (-0.10, 0.10, 0.00), (-0.10, -0.10, 0.01), (0.10, -0.10, 0.01), (0.10, 0.10, 0.01), (-0.10, 0.10, 0.01)]
        float3[] extent = [(-0.10, -0.10, 0.00), (0.10, 0.10, 0.01)]
        token physics:approximation = "convexHull"
        uniform token subdivisionScheme = "none"
        uniform bool doubleSided = 1
        rel material:binding = </bin/Looks/BlueMaterial>
    }

    # Left wall, -Y. Outer face at y = -0.10, inner face at y = -0.08.
    def Mesh "wall_left" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
    )
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 2, 3, 7, 6, 0, 4, 7, 3, 1, 2, 6, 5]
        point3f[] points = [(-0.10, -0.10, 0.01), (0.10, -0.10, 0.01), (0.10, -0.08, 0.01), (-0.10, -0.08, 0.01), (-0.10, -0.10, 0.09), (0.10, -0.10, 0.09), (0.10, -0.08, 0.09), (-0.10, -0.08, 0.09)]
        float3[] extent = [(-0.10, -0.10, 0.01), (0.10, -0.08, 0.09)]
        token physics:approximation = "convexHull"
        uniform token subdivisionScheme = "none"
        uniform bool doubleSided = 1
        rel material:binding = </bin/Looks/BlueMaterial>
    }

    # Right wall, +Y.
    def Mesh "wall_right" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
    )
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 2, 3, 7, 6, 0, 4, 7, 3, 1, 2, 6, 5]
        point3f[] points = [(-0.10, 0.08, 0.01), (0.10, 0.08, 0.01), (0.10, 0.10, 0.01), (-0.10, 0.10, 0.01), (-0.10, 0.08, 0.09), (0.10, 0.08, 0.09), (0.10, 0.10, 0.09), (-0.10, 0.10, 0.09)]
        float3[] extent = [(-0.10, 0.08, 0.01), (0.10, 0.10, 0.09)]
        token physics:approximation = "convexHull"
        uniform token subdivisionScheme = "none"
        uniform bool doubleSided = 1
        rel material:binding = </bin/Looks/BlueMaterial>
    }

    # Front wall, +X. Stops at the inner faces of the side walls so the corners are not doubled.
    def Mesh "wall_front" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
    )
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 2, 3, 7, 6, 0, 4, 7, 3, 1, 2, 6, 5]
        point3f[] points = [(0.08, -0.08, 0.01), (0.10, -0.08, 0.01), (0.10, 0.08, 0.01), (0.08, 0.08, 0.01), (0.08, -0.08, 0.09), (0.10, -0.08, 0.09), (0.10, 0.08, 0.09), (0.08, 0.08, 0.09)]
        float3[] extent = [(0.08, -0.08, 0.01), (0.10, 0.08, 0.09)]
        token physics:approximation = "convexHull"
        uniform token subdivisionScheme = "none"
        uniform bool doubleSided = 1
        rel material:binding = </bin/Looks/BlueMaterial>
    }

    # Back wall, -X.
    def Mesh "wall_back" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
    )
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 2, 3, 7, 6, 0, 4, 7, 3, 1, 2, 6, 5]
        point3f[] points = [(-0.10, -0.08, 0.01), (-0.08, -0.08, 0.01), (-0.08, 0.08, 0.01), (-0.10, 0.08, 0.01), (-0.10, -0.08, 0.09), (-0.08, -0.08, 0.09), (-0.08, 0.08, 0.09), (-0.10, 0.08, 0.09)]
        float3[] extent = [(-0.10, -0.08, 0.01), (-0.08, 0.08, 0.09)]
        token physics:approximation = "convexHull"
        uniform token subdivisionScheme = "none"
        uniform bool doubleSided = 1
        rel material:binding = </bin/Looks/BlueMaterial>
    }
}
