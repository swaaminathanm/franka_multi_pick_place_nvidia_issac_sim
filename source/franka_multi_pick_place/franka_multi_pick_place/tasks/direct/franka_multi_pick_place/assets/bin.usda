#usda 1.0
(
    defaultPrim = "bin"
    metersPerUnit = 1.0
    upAxis = "Z"
)

# Hollow bin: one kinematic rigid body, five convex cubes.
# Outer 0.20 x 0.20 m, floor 0.01 m, walls 0.02 m thick and 0.08 m tall.
# Inner cavity is 0.16 x 0.16 x 0.08 m.
# A USD Cube is a 1 m cube centered on itself. scale is the real size.
# translate moves the center, not a corner.

def Xform "bin" (
    kind = "component"
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    bool physics:kinematicEnabled = true
    float physics:mass = 0.5

    def Scope "Looks"
    {
        def Material "BlueMaterial"
        {
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.10, 0.45, 0.85)
                float inputs:roughness = 0.4
                float inputs:metallic = 0.0
                token outputs:surface
            }
            token outputs:surface.connect = </bin/Looks/BlueMaterial/Shader.outputs:surface>
        }
    }

    # Floor center Z = thickness / 2 = 0.005
    def Cube "floor" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        bool physics:collisionEnabled = true
        double size = 1.0
        double3 xformOp:scale = (0.20, 0.20, 0.01)
        double3 xformOp:translate = (0.0, 0.0, 0.005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </bin/Looks/BlueMaterial>
    }

    # Side walls span the full outer length. Center Y = ±(0.10 - 0.01) = ±0.09
    # Center Z = floor thickness + wall height / 2 = 0.05
    def Cube "wall_left" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        bool physics:collisionEnabled = true
        double size = 1.0
        double3 xformOp:scale = (0.20, 0.02, 0.08)
        double3 xformOp:translate = (0.0, -0.09, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </bin/Looks/BlueMaterial>
    }

    def Cube "wall_right" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        bool physics:collisionEnabled = true
        double size = 1.0
        double3 xformOp:scale = (0.20, 0.02, 0.08)
        double3 xformOp:translate = (0.0, 0.09, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </bin/Looks/BlueMaterial>
    }

    # Front and back fill only the inner gap: 0.20 - 2 * 0.02 = 0.16
    def Cube "wall_front" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        bool physics:collisionEnabled = true
        double size = 1.0
        double3 xformOp:scale = (0.02, 0.16, 0.08)
        double3 xformOp:translate = (0.09, 0.0, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </bin/Looks/BlueMaterial>
    }

    def Cube "wall_back" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        bool physics:collisionEnabled = true
        double size = 1.0
        double3 xformOp:scale = (0.02, 0.16, 0.08)
        double3 xformOp:translate = (-0.09, 0.0, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </bin/Looks/BlueMaterial>
    }
}
