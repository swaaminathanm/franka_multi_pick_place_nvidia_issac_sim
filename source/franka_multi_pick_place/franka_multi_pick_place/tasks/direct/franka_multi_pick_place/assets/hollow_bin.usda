#usda 1.0
(
    defaultPrim = "hollow_bin"
    metersPerUnit = 1.0
    upAxis = "Z"
)

def Xform "hollow_bin" (
    kind = "component"
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.5

    def Scope "Looks"
    {
        def Material "BlueMaterial"
        {
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.10, 0.45, 0.85)
                float inputs:roughness = 0.4
                float inputs:metallic = 0.0
                token outputs:surface
            }
            token outputs:surface.connect = </hollow_bin/Looks/BlueMaterial/Shader.outputs:surface>
        }
    }

    # Bottom plate: 18cm x 18cm x 1cm (Center Z = 0.005)
    def Cube "bottom" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        bool physics:collisionEnabled = true
        double size = 1.0
        double3 xformOp:scale = (0.18, 0.18, 0.01)
        double3 xformOp:translate = (0.0, 0.0, 0.005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </hollow_bin/Looks/BlueMaterial>
    }

    # Left wall (-Y): 18cm x 1.5cm x 6cm (Center Z = 0.040)
    def Cube "wall_left" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        bool physics:collisionEnabled = true
        double size = 1.0
        double3 xformOp:scale = (0.18, 0.015, 0.06)
        double3 xformOp:translate = (0.0, -0.0825, 0.040)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </hollow_bin/Looks/BlueMaterial>
    }

    # Right wall (+Y): 18cm x 1.5cm x 6cm (Center Z = 0.040)
    def Cube "wall_right" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        bool physics:collisionEnabled = true
        double size = 1.0
        double3 xformOp:scale = (0.18, 0.015, 0.06)
        double3 xformOp:translate = (0.0, 0.0825, 0.040)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </hollow_bin/Looks/BlueMaterial>
    }

    # Front wall (+X): 15cm x 1.5cm x 6cm (Center Z = 0.040)
    def Cube "wall_front" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        bool physics:collisionEnabled = true
        double size = 1.0
        double3 xformOp:scale = (0.015, 0.15, 0.06)
        double3 xformOp:translate = (0.0825, 0.0, 0.040)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </hollow_bin/Looks/BlueMaterial>
    }

    # Back wall (-X): 15cm x 1.5cm x 6cm (Center Z = 0.040)
    def Cube "wall_back" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        bool physics:collisionEnabled = true
        double size = 1.0
        double3 xformOp:scale = (0.015, 0.15, 0.06)
        double3 xformOp:translate = (-0.0825, 0.0, 0.040)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </hollow_bin/Looks/BlueMaterial>
    }
}